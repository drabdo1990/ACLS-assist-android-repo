<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme (night-mode ResusCode HUD). -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#050811</item>
        <item name="colorPrimaryDark">#050811</item>
        <item name="colorAccent">#06B6D4</item>
        <item name="android:windowBackground">#050811</item>
        <item name="android:statusBarColor">#050811</item>
        <item name="android:navigationBarColor">#050811</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#050811</item>
        <item name="android:statusBarColor">#050811</item>
        <item name="android:navigationBarColor">#050811</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#050811</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>